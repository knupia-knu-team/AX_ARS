# ═══════════════════════════════════════════════════════════
# VoiceRoute AX — Environment Variables Template
# ═══════════════════════════════════════════════════════════

# Server Port (Cloud Run automatically sets this to 8080)
PORT=3001

# Node Environment (development or production)
NODE_ENV=development

# ── Gemini Integration (Planned for Phase 2) ──
# GCP Project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Location (Seoul region is recommended for Asia)
GOOGLE_CLOUD_LOCATION=asia-northeast3

# Vertex AI Gemini model identifier
VERTEX_AI_MODEL=gemini-2.0-flash

# Enable actual Gemini calls (false will default to Mock Rule Engine)
USE_VERTEX_AI=false

# Backward-compatible aliases used by older server code paths
USE_GEMINI=false
GEMINI_MODEL=gemini-2.0-flash
